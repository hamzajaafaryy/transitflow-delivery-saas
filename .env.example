PORT=3000
HOST=127.0.0.1
DB_PATH=./data/delivery.sqlite
# Set before exposing the app on any non-local interface. 32+ random characters.
SESSION_SECRET=replace-with-64-hex-random-characters
PUBLIC_BASE_URL=http://localhost:3000
# Codespaces: the forwarded HTTPS origin is detected when this stays localhost.
# Only enable when hosted behind an HTTPS proxy with secure cookies.
COOKIE_SECURE=false

{
  "name": "transitflow-delivery",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-syntax.mjs && node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.cjs"
  },
  "description": "Single-company Moroccan delivery operations: merchant pickups, warehouse, city dispatch, delivery attempts, returns, claims and reconciled COD."
}
